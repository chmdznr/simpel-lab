# Salin file ini menjadi .env sebelum menjalankan apa pun:
#   cp .env.contoh .env
#
# Nilai bawaan di bawah sudah cocok untuk laptop sendiri. Yang perlu diubah
# hanya kalau (a) port di laptop Anda sudah dipakai aplikasi lain, atau
# (b) Anda memakai BROKER CADANGAN terpusat -- lihat bagian paling bawah.

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=simpel
RABBITMQ_PASS=simpel123
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Alamat broker yang dipakai kode Node.js.
AMQP_URL=amqp://simpel:simpel123@localhost:5672

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=simpel
POSTGRES_PASSWORD=simpel123
POSTGRES_DB=simpel
POSTGRES_PORT=5432

DATABASE_URL=postgres://simpel:simpel123@localhost:5432/simpel

# --- Observability (baru dipakai MP-9, Hari 5) ------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASS=admin

# --- Port layanan SIMPEL ----------------------------------------------------
PORT_GATEWAY=3001
PORT_VALIDASI=3002
PORT_BILLING=3003
PORT_NOTIFIKASI=3004

# --- Tombol untuk demo di kelas --------------------------------------------
# Lama notifikasi berpura-pura menunggu pihak ketiga. 3000 ms = 3 detik.
# Inilah sumber LI-3 pada Demo B (MP-2).
NOTIF_DELAY_MS=3000

# Berapa milidetik "kerja berat" yang dibakar layanan validasi tiap pengajuan.
# Ini yang membuat CPU dan database ikut terbebani (sumber LI-2).
VALIDASI_KERJA_MS=120

# --- BROKER CADANGAN TERPUSAT ----------------------------------------------
# Kalau Docker di laptop kantor diblokir kebijakan IT, JANGAN mengubah kode.
# Cukup komentari AMQP_URL di atas dan aktifkan baris di bawah ini
# (alamat, user, dan password asli dibagikan panitia di hari-H):
#
# AMQP_URL=amqp://<user-anda>:<password-anda>@broker.pelatihan.example:5672/<vhost-anda>
#
# Setiap peserta mendapat vhost sendiri supaya queue tidak bertabrakan.
