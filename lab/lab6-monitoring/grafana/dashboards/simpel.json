{
  "uid": "simpel-ops",
  "title": "SIMPEL — Queue Evidence",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "SIMPEL",
    "classroom"
  ],
  "templating": {"list": [{"name": "vhost", "label": "Vhost", "type": "query", "datasource": {"type": "prometheus", "uid": "simpel-prometheus"}, "query": "label_values(rabbitmq_queue_messages_ready, vhost)", "refresh": 1, "includeAll": true, "allValue": ".*", "multi": false, "current": {"text": "lab6", "value": "lab6"}}]},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ready messages",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "simpel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{vhost=~\"$vhost\"}",
          "legendFormat": "{{vhost}} / {{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unacknowledged messages",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "simpel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_unacked{vhost=~\"$vhost\"}",
          "legendFormat": "{{vhost}} / {{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumers",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "simpel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_consumers{vhost=~\"$vhost\"}",
          "legendFormat": "{{vhost}} / {{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Delivery and acknowledgement rate",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "simpel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vhost, queue) (rate(rabbitmq_detailed_queue_messages_delivered_ack_total{vhost=~\"$vhost\"}[1m]))",
          "legendFormat": "delivery: {{vhost}} / {{queue}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (vhost, queue) (rate(rabbitmq_detailed_queue_messages_acked_total{vhost=~\"$vhost\"}[1m]))",
          "legendFormat": "ack: {{vhost}} / {{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Redelivery rate",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "simpel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vhost, queue) (rate(rabbitmq_detailed_queue_messages_redelivered_total{vhost=~\"$vhost\"}[1m]))",
          "legendFormat": "{{vhost}} / {{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape health",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "simpel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"rabbitmq.*\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
